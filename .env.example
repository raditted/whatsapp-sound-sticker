# Trigger command (video caption or reply to a video)
COMMAND=.s
# Comma-separated WhatsApp group JIDs allowed to use the bot
# Example: ALLOWED_GROUPS=120363000000000000@g.us,120363111111111111@g.us
ALLOWED_GROUPS=

# Allow commands from any group (overrides ALLOWED_GROUPS)
ALLOW_ALL_GROUPS=false

# Allow commands in direct messages (1:1 chats)
ALLOW_DM=false

# Allow triggering commands from the bot's own WhatsApp account
ALLOW_SELF=true

# Only send stickers and reactions. never text replies
SILENT_MODE=true

# Sticker pack metadata (EXIF)2
STICKER_PACK=Sound Sticker
STICKER_AUTHOR=whatsapp-sound-sticker
STICKER_PACK_ID=com.whatsapp.soundsticker

# Media limits (optional — set MAX_VIDEO_SECONDS / MAX_AUDIO_SECONDS to 0 to disable trimming)
MAX_VIDEO_SECONDS=10
MAX_AUDIO_SECONDS=9.9
MAX_WEBP_BYTES=1000000

# Paths & logging
AUTH_DIR=auth
TMP_DIR=tmp
QR_IMAGE_PATH=qr.png
LOG_LEVEL=warn

# Optional custom binary paths (defaults to system PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional HTTP/HTTPS proxy
# HTTPS_PROXY=http://user:pass@host:port
